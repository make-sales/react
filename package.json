{
  "name": "@make-sales/react",
  "version": "0.1.0",
  "description": "React provider and hooks for Make Sales Control",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.tsx\"",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@make-sales/client": ">=0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@make-sales/client": "git+https://github.com/make-sales/client.git#main",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "@types/react-test-renderer": "^18.3.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
